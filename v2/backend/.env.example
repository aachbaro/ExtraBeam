DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
FRONTEND_URL=http://127.0.0.1:5180
OIDC_ISSUER_URL=http://127.0.0.1:8001
OIDC_CLIENT_ID=extrabeam-web
OIDC_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180

# Electronic invoicing: sandbox/production use the same official API host.
SUPERPDP_BASE_URL=https://api.superpdp.tech
SUPERPDP_CLIENT_ID=
SUPERPDP_CLIENT_SECRET=
SUPERPDP_REDIRECT_URI=http://127.0.0.1:8002/api/einvoicing/callback/
SUPERPDP_ENVIRONMENT=sandbox
# Reserved, unused until SUPER PDP publishes its signature contract.
SUPERPDP_WEBHOOK_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EINVOICE_TOKEN_KEY=
# Optional invoice payments, independent from electronic invoicing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=False

# Recruitment notifications (leave secrets in the local/server env only).
RECRUITMENT_WAVE_MINUTES=15
RECRUITMENT_PUBLIC_URL=https://rivebelle.app
EMAIL_HOST=
BREVO_API_KEY=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Rivebelle <notifications@rivebelle.app>
WEBPUSH_PUBLIC_KEY=
# Absolute PEM file path in the Docker data volume, e.g. /app/data/webpush-private.pem
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:contact@rivebelle.app
